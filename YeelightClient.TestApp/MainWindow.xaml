<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Yeelight.TestApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Yeelight Client Test App">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Number1" Invoked="Accelerator_Invoked" Modifiers="Control" />
            <KeyboardAccelerator Key="Number2" Invoked="Accelerator_Invoked" Modifiers="Control" />
            <KeyboardAccelerator Key="Number3" Invoked="Accelerator_Invoked" Modifiers="Control" />
            <KeyboardAccelerator Key="Number4" Invoked="Accelerator_Invoked" Modifiers="Control" />
            <KeyboardAccelerator Key="Number5" Invoked="Accelerator_Invoked" Modifiers="Control" />
            <KeyboardAccelerator Key="Number6" Invoked="Accelerator_Invoked" Modifiers="Control" />
            <KeyboardAccelerator Key="F1" Invoked="Accelerator_Invoked" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Yeelight Client Test App"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppIcon.png" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            OpenPaneLength="220"
            DisplayModeChanged="NavView_DisplayModeChanged"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="Lights"
                    IsSelected="True"
                    Tag="lights"
                    ToolTipService.ToolTip="Lights (Ctrl+1)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE82F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Control"
                    Tag="control"
                    ToolTipService.ToolTip="Control (Ctrl+2)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9E9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Raw"
                    Tag="raw"
                    ToolTipService.ToolTip="Raw commands and the protocol (Ctrl+3)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE943;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Events"
                    Tag="events"
                    ToolTipService.ToolTip="Events (Ctrl+4)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Log"
                    Tag="log"
                    ToolTipService.ToolTip="Log of the wire (Ctrl+5)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    Content="Settings"
                    Tag="settings"
                    ToolTipService.ToolTip="Settings (Ctrl+6)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="Help"
                    Tag="help"
                    ToolTipService.ToolTip="Help and about (F1)">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE897;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.PaneFooter>
                <StackPanel
                    x:Name="StatusPanel"
                    Margin="16,8,16,16"
                    Spacing="4">
                    <TextBlock
                        x:Name="StatusText"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="No lights yet"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="ActivityText"
                        Style="{StaticResource SecondaryCaptionStyle}"
                        Text="Nothing is sent to the network until you ask."
                        TextWrapping="Wrap" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>

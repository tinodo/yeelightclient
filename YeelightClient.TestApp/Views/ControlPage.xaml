<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Yeelight.TestApp.Views.ControlPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:Yeelight.TestApp.Controls"
    xmlns:local="using:Yeelight.TestApp.Views"
    xmlns:models="using:Yeelight.TestApp.Models"
    xmlns:session="using:Yeelight.TestApp.Session"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Control" />
            <TextBlock
                Style="{StaticResource SecondaryBodyStyle}"
                Text="Try every command of the library on the selected light. How each one went (the time that the light took, or why it did not work) is shown at the bottom, and what the light says it is now follows it, also when a change is made from another app." />
        </StackPanel>

        <controls:WrapPanel
            Grid.Row="1"
            HorizontalSpacing="12"
            VerticalSpacing="8">
            <ComboBox
                x:Name="LightBox"
                Width="300"
                AutomationProperties.Name="Light to control"
                ItemsSource="{x:Bind Items}"
                PlaceholderText="Choose a light"
                SelectionChanged="LightBox_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="session:LightItem">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border
                                Width="10"
                                Height="10"
                                VerticalAlignment="Center"
                                Background="{x:Bind SwatchBrush, Mode=OneWay}"
                                CornerRadius="5" />
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button
                x:Name="RefreshButton"
                AutomationProperties.Name="Refresh: read all the properties of the light"
                Click="RefreshButton_Click"
                ToolTipService.ToolTip="Reads all the properties of the light again, with get_prop (F5)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE72C;" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="F5" />
                </Button.KeyboardAccelerators>
            </Button>
            <ProgressRing
                x:Name="BusyRing"
                Width="20"
                Height="20"
                VerticalAlignment="Center"
                AutomationProperties.Name="A command is on its way"
                IsActive="False" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleSwitch
                    x:Name="TransitionSwitch"
                    AutomationProperties.Name="Use a transition for the commands that take one"
                    OffContent="Transition"
                    OnContent="Transition"
                    Toggled="Transition_Changed"
                    ToolTipService.ToolTip="Off: commands are sudden. On: every command that takes a transition (power, brightness, colour temperature, colour) is smooth and takes this long." />
                <NumberBox
                    x:Name="TransitionBox"
                    Width="130"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Duration of the transition in milliseconds, 30 or more"
                    Maximum="600000"
                    Minimum="30"
                    SmallChange="100"
                    SpinButtonPlacementMode="Compact"
                    ValueChanged="TransitionBox_ValueChanged"
                    Value="500" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryBodyStyle}" Text="ms" />
            </StackPanel>
        </controls:WrapPanel>

        <Grid x:Name="ContentGrid" Grid.Row="2" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Padding="16,4,16,4" Style="{StaticResource CardStyle}">
                <Expander
                    x:Name="StateExpander"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="What the light is now"
                    IsExpanded="True">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Grid
                                Width="12"
                                Height="12"
                                VerticalAlignment="Center">
                                <Ellipse x:Name="ConnectedDot" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                <Ellipse x:Name="DisconnectedDot" Fill="{ThemeResource TextFillColorDisabledBrush}" Visibility="Collapsed" />
                            </Grid>
                            <Border
                                x:Name="StateSwatch"
                                Width="22"
                                Height="22"
                                VerticalAlignment="Center"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="11" />
                            <TextBlock
                                x:Name="StateTitle"
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Name="StateSummary"
                                VerticalAlignment="Center"
                                Style="{StaticResource SecondaryBodyStyle}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                    </Expander.Header>
                    <ItemsControl x:Name="StateList" AutomationProperties.Name="Live state of the light">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:WrapPanel HorizontalSpacing="24" VerticalSpacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PropertyRow">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind Name}" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Value}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Expander>
            </Border>

            <SelectorBar
                x:Name="Tabs"
                Grid.Row="1"
                AutomationProperties.Name="Sections of the Control page"
                SelectionChanged="Tabs_SelectionChanged">
                <SelectorBarItem
                    x:Name="LightTab"
                    IsSelected="True"
                    Tag="light"
                    Text="Light" />
                <SelectorBarItem
                    x:Name="BackgroundTab"
                    Tag="background"
                    Text="Background light" />
                <SelectorBarItem
                    x:Name="DeviceTab"
                    Tag="device"
                    Text="Device" />
                <SelectorBarItem
                    x:Name="MusicTab"
                    Tag="music"
                    Text="Music mode" />
            </SelectorBar>

            <Grid Grid.Row="2">
                <ScrollViewer x:Name="LightView" VerticalScrollBarVisibility="Auto">
                    <local:LightPanel x:Name="MainPanel" Margin="0,0,12,12" />
                </ScrollViewer>

                <ScrollViewer
                    x:Name="BackgroundView"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <StackPanel Margin="0,0,12,12" Spacing="12">
                        <TextBlock Style="{StaticResource SecondaryBodyStyle}" Text="The background light of a ceiling light has a state of its own, and takes the same commands as the main light with the prefix bg_ (bg_set_power, bg_set_bright, ...)." />
                        <local:LightPanel x:Name="BackgroundPanel" />
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer
                    x:Name="DeviceView"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <controls:MasonryPanel
                        Margin="0,0,12,12"
                        MaxColumns="3"
                        MinColumnWidth="440"
                        Spacing="12">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Name" />
                                <TextBox
                                    x:Name="NameBox"
                                    AutomationProperties.Name="Name of the light"
                                    KeyDown="NameBox_KeyDown"
                                    PlaceholderText="A name for the light"
                                    TextChanged="NameBox_TextChanged" />
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button
                                        x:Name="SetNameButton"
                                        AutomationProperties.Name="Set the name of the light"
                                        Click="SetNameButton_Click"
                                        Content="Set name"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <TextBlock
                                        x:Name="NameCount"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SecondaryCaptionStyle}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="set_name: the name is kept by the light and reported when it is found, at most 64 bytes in UTF-8. The Yeelight app keeps names of its own in the cloud, so the two can differ." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Sleep timer" />
                                <TextBlock
                                    x:Name="TimerText"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                    <NumberBox
                                        x:Name="TimerBox"
                                        Width="130"
                                        AutomationProperties.Name="Minutes until the light is turned off"
                                        Header="Minutes"
                                        Maximum="1440"
                                        Minimum="1"
                                        SpinButtonPlacementMode="Compact"
                                        Value="30" />
                                    <Button
                                        x:Name="SetTimerButton"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.Name="Set the sleep timer"
                                        Click="SetTimerButton_Click"
                                        Content="Set timer"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        x:Name="GetTimerButton"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.Name="Get the sleep timer"
                                        Click="GetTimerButton_Click"
                                        Content="Get timer" />
                                    <Button
                                        x:Name="CancelTimerButton"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.Name="Cancel the sleep timer"
                                        Click="CancelTimerButton_Click"
                                        Content="Cancel timer" />
                                </controls:WrapPanel>
                                <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="cron_add, cron_get and cron_del: the light is turned off after the minutes. A light has one timer, a new one replaces it, and only a light that is on accepts one. The time that is left is the delayoff property, which SleepTimerRemaining shows." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Connection and properties" />
                                <TextBlock
                                    x:Name="ConnectionText"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                    <Button
                                        x:Name="ConnectButton"
                                        AutomationProperties.Name="Connect to the light"
                                        Click="ConnectButton_Click"
                                        Content="Connect" />
                                    <Button
                                        x:Name="DisconnectButton"
                                        AutomationProperties.Name="Disconnect from the light"
                                        Click="DisconnectButton_Click"
                                        Content="Disconnect" />
                                    <Button
                                        x:Name="ToggleAllButton"
                                        AutomationProperties.Name="Toggle the main light and the background light"
                                        Click="ToggleAllButton_Click"
                                        Content="Toggle both lights"
                                        ToolTipService.ToolTip="dev_toggle: switches the main light and the background light, as they are, at the same time" />
                                </controls:WrapPanel>
                                <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="A light takes four connections and the client keeps one: Connect makes it (a command makes it too, when there is none), Disconnect closes it. Refresh, at the top, reads all the properties again with get_prop." />
                            </StackPanel>
                        </Border>
                    </controls:MasonryPanel>
                </ScrollViewer>

                <ScrollViewer
                    x:Name="MusicView"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <controls:MasonryPanel
                        Margin="0,0,12,12"
                        MaxColumns="2"
                        MinColumnWidth="520"
                        Spacing="12">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Music mode" />
                                <TextBlock Style="{StaticResource SecondaryBodyStyle}" Text="The light connects to this computer and takes the commands that it gets over that connection without the limit of 60 a minute, and without answering them: it is what it takes to follow music or a screen. It needs the firewall of this computer to let the light connect to the port that it is told." />
                                <TextBox
                                    x:Name="MusicAddressBox"
                                    AutomationProperties.Name="Address of this computer that the light connects to"
                                    Header="Address of this computer (empty for the address that reaches the light)"
                                    PlaceholderText="Automatic" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="StartMusicButton"
                                        AutomationProperties.Name="Start music mode"
                                        Click="StartMusicButton_Click"
                                        Content="Start music mode"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        x:Name="StopMusicButton"
                                        AutomationProperties.Name="Stop music mode"
                                        Click="StopMusicButton_Click"
                                        Content="Stop music mode" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="MusicStatus"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Demo" />
                                <TextBlock Style="{StaticResource SecondaryBodyStyle}" Text="Sends a colour that goes round the rainbow (set_hsv, and now and then set_rgb), about 20 commands a second, over the music session. A light without colours changes its brightness instead." />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <NumberBox
                                        x:Name="DemoSecondsBox"
                                        Width="130"
                                        AutomationProperties.Name="How many seconds the demo runs"
                                        Header="Seconds"
                                        Maximum="300"
                                        Minimum="1"
                                        SpinButtonPlacementMode="Compact"
                                        Value="10" />
                                    <Button
                                        x:Name="RunDemoButton"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.Name="Run the demo"
                                        Click="RunDemoButton_Click"
                                        Content="Run demo"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        x:Name="StopDemoButton"
                                        VerticalAlignment="Bottom"
                                        AutomationProperties.Name="Stop the demo"
                                        Click="StopDemoButton_Click"
                                        Content="Stop demo" />
                                </StackPanel>
                                <ProgressBar
                                    x:Name="DemoProgress"
                                    AutomationProperties.Name="Progress of the demo"
                                    Maximum="1"
                                    Minimum="0"
                                    Value="0" />
                                <TextBlock
                                    x:Name="DemoResult"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="A control connection allows 60 commands a minute (one a second): the demo sends more than 1200 in the same time. Music mode ends when the session is stopped, or when the light closes the connection (session.Completion): this page then says so." />
                            </StackPanel>
                        </Border>
                    </controls:MasonryPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <StackPanel
            x:Name="EmptyPanel"
            Grid.Row="2"
            MaxWidth="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="Collapsed">
            <TextBlock
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}"
                Text="No light to control" />
            <TextBlock
                Style="{StaticResource SecondaryBodyStyle}"
                Text="Find a light on the Lights page (Search now, Probe address, or the simulated lights to try the app without one), select it, and it appears here."
                TextAlignment="Center" />
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    AutomationProperties.Name="Go to the Lights page"
                    Click="GoToLightsButton_Click"
                    Content="Go to Lights"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    AutomationProperties.Name="Start the simulated lights"
                    Click="StartSimulatedButton_Click"
                    Content="Start the simulated lights" />
            </StackPanel>
        </StackPanel>

        <InfoBar
            x:Name="OutcomeBar"
            Grid.Row="3"
            IsClosable="True"
            IsOpen="False"
            Severity="Informational" />
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Yeelight.TestApp.Views.EventsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:Yeelight.TestApp.Controls"
    xmlns:svc="using:Yeelight.TestApp.Services"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,16,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Events" />
            <TextBlock
                Style="{StaticResource SecondaryBodyStyle}"
                Text="Every event as the client raises it: DeviceDiscovered when a light is found, DeviceStateChanged for each property of each light that changes, and PropertyChanged of the light that is selected. The value is read from the light when the app handles the event." />
        </StackPanel>

        <controls:WrapPanel
            Grid.Row="1"
            HorizontalSpacing="8"
            VerticalSpacing="8">
            <ComboBox
                x:Name="LightBox"
                Width="230"
                AutomationProperties.Name="Show the events of one light"
                SelectionChanged="Filter_Changed" />
            <ComboBox
                x:Name="KindBox"
                Width="210"
                AutomationProperties.Name="Show one kind of event"
                SelectionChanged="Filter_Changed" />
            <AutoSuggestBox
                x:Name="FilterBox"
                Width="250"
                AutomationProperties.Name="Filter the events"
                PlaceholderText="Filter by text"
                QueryIcon="Find"
                TextChanged="FilterBox_TextChanged" />
            <ToggleButton
                x:Name="FollowButton"
                AutomationProperties.Name="Follow the newest event"
                Content="Follow"
                IsChecked="True"
                ToolTipService.ToolTip="Scrolls to the newest event as it arrives, as long as no event is selected" />
            <ToggleButton
                x:Name="PauseButton"
                AutomationProperties.Name="Pause the list"
                Click="PauseButton_Click"
                Content="Pause"
                ToolTipService.ToolTip="Stops adding events to the list. They are still recorded, and show when you resume." />
            <Button
                AutomationProperties.Name="Clear the events"
                Click="ClearButton_Click"
                Content="Clear" />
            <Button
                x:Name="CopyAllButton"
                AutomationProperties.Name="Copy the events that are shown"
                Click="CopyAllButton_Click"
                Content="Copy" />
            <Button
                AutomationProperties.Name="Export the events that are shown as JSON lines"
                Click="ExportButton_Click"
                Content="Export" />
            <TextBlock
                x:Name="CountText"
                VerticalAlignment="Center"
                Style="{StaticResource SecondaryCaptionStyle}" />
        </controls:WrapPanel>

        <InfoBar
            x:Name="ExportBar"
            Grid.Row="2"
            IsOpen="False"
            Severity="Success">
            <InfoBar.ActionButton>
                <Button Click="ShowInFolderButton_Click" Content="Show in folder" />
            </InfoBar.ActionButton>
        </InfoBar>

        <controls:ResponsiveSplit Grid.Row="3" Breakpoint="820">
            <Border Padding="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <ListView
                        x:Name="EventList"
                        AutomationProperties.Name="Events"
                        ItemsSource="{x:Bind Visible}"
                        SelectionChanged="EventList_SelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="32" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="svc:EventEntry">
                                <Grid Padding="0,2" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CodeTextStyle}"
                                        Text="{x:Bind TimeText}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind KindText}"
                                        TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock
                                            Text="{x:Bind Summary}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                        <TextBlock
                                            Style="{StaticResource SecondaryCaptionStyle}"
                                            Text="{x:Bind LightText}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        x:Name="EmptyText"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Style="{StaticResource SecondaryBodyStyle}"
                        Text="No events yet. Search for lights, probe an address or start the simulated lights on the Lights page: every event that the client raises appears here."
                        TextAlignment="Center" />
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="DetailTitle"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Select an event"
                        TextWrapping="Wrap" />
                    <TextBox
                        x:Name="DetailBox"
                        Grid.Row="1"
                        AutomationProperties.Name="Event data"
                        IsReadOnly="True"
                        Style="{StaticResource CodeTextBoxStyle}" />
                    <Button
                        x:Name="CopyButton"
                        Grid.Row="2"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Copy the data of the event"
                        Click="CopyButton_Click"
                        Content="Copy" />
                </Grid>
            </Border>
        </controls:ResponsiveSplit>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Yeelight.TestApp.Views.HelpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:Yeelight.TestApp.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel
            MaxWidth="{StaticResource PageMaxWidth}"
            Padding="{StaticResource PagePadding}"
            HorizontalAlignment="Left"
            Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Help and about" />
                <TextBlock
                    Style="{StaticResource SecondaryBodyStyle}"
                    Text="This app is made to try every feature of the Yeelight Client library by hand, against your own lights (or against lights that it simulates inside the app), and to explore the protocol. It uses nothing but the public API of the library." />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="About" />
                    <Grid ColumnSpacing="16" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SecondaryBodyStyle}" Text="Yeelight Client library" />
                        <TextBlock
                            x:Name="LibraryText"
                            Grid.Column="1"
                            IsTextSelectionEnabled="True" />
                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource SecondaryBodyStyle}"
                            Text="Test app" />
                        <TextBlock
                            x:Name="AppText"
                            Grid.Row="1"
                            Grid.Column="1"
                            IsTextSelectionEnabled="True" />
                        <TextBlock
                            Grid.Row="2"
                            Style="{StaticResource SecondaryBodyStyle}"
                            Text="Runtime" />
                        <TextBlock
                            x:Name="RuntimeText"
                            Grid.Row="2"
                            Grid.Column="1"
                            IsTextSelectionEnabled="True" />
                        <TextBlock
                            Grid.Row="3"
                            Style="{StaticResource SecondaryBodyStyle}"
                            Text="Settings" />
                        <TextBlock
                            x:Name="SettingsText"
                            Grid.Row="3"
                            Grid.Column="1"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                    </Grid>
                    <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="4">
                        <HyperlinkButton Content="Documentation" NavigateUri="https://tinodo.github.io/yeelightclient/" />
                        <HyperlinkButton Content="Source code on GitHub" NavigateUri="https://github.com/tinodo/yeelightclient" />
                        <HyperlinkButton Content="Report an issue" NavigateUri="https://github.com/tinodo/yeelightclient/issues" />
                        <HyperlinkButton Content="NuGet package" NavigateUri="https://www.nuget.org/packages/YeelightClient" />
                        <HyperlinkButton Content="Yeelight Inter-Operation Specification (PDF)" NavigateUri="https://www.yeelight.com/download/Yeelight_Inter-Operation_Spec.pdf" />
                    </controls:WrapPanel>
                    <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="Yeelight Client is an independent open source project. It is not affiliated with or endorsed by Yeelight." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Switch on LAN Control for every light" />
                    <TextBlock
                        Style="{StaticResource SecondaryBodyStyle}"
                        Text="A light only talks to this app (and to any program that uses the local network) when LAN Control is on. Without it the light neither answers a search nor accepts a connection, so it does not show up here, or it shows up and refuses every command." />
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="1. Open the Yeelight app, and select the light." />
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="2. Open the settings of the light (the three dots or the gear, on the page of the light)." />
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="3. Switch on LAN Control (the name can differ a little between versions of the app, for example Local Control)." />
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="4. Do the same for every other light: the setting belongs to each light, not to the account." />
                    <TextBlock
                        Style="{StaticResource SecondaryCaptionStyle}"
                        Text="The light and this computer have to be on the same network, and the router has to let them talk (a guest network or a network with client isolation does not). When the search finds nothing but you know the address of a light, use Probe address on the Lights page: it asks that one address, also across a VPN or from another subnet." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Good to know" />
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="• A light takes four connections at the same time, and 60 commands a minute on each. The client keeps one connection to a light, so when a light refuses connections, close the other apps and programs that talk to it (the Yeelight app, Home Assistant, a bridge) and try again." />
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="• Commands that would go over the 60 a minute are held back by the client, and fail with the kind RateLimited when that would take more than two seconds. Music mode has no limit, and does not answer the commands that it takes." />
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="• Nothing is sent to the network when the app starts. Searching, listening and probing start when you press a button, and the app never scans a network: it only talks to the addresses that lights announce themselves from, and to the one you probe." />
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="• The simulated lights live inside this app, on the loopback address (127.0.0.1): nothing that they do leaves this computer, and no real light is asked or answered." />
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="• Most commands are only accepted by a light that is on: a light that is off refuses a change of brightness or colour. A scene is the exception, it switches the light on first." />
                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="• The Log page shows exactly what goes over the wire, and the Raw page sends anything you type: the best way to find out what a light does." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Keyboard shortcuts" />
                    <Grid ColumnSpacing="16" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource CodeTextStyle}" Text="Ctrl+1 … Ctrl+6" />
                        <TextBlock Grid.Column="1" Text="Lights, Control, Raw, Events, Log, Settings" />
                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource CodeTextStyle}"
                            Text="F1" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="This page" />
                        <TextBlock
                            Grid.Row="2"
                            Style="{StaticResource CodeTextStyle}"
                            Text="F5 or Ctrl+R" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            Text="Search now (on the Lights page)" />
                        <TextBlock
                            Grid.Row="3"
                            Style="{StaticResource CodeTextStyle}"
                            Text="Ctrl+Enter" />
                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="1"
                            Text="Send the command (on the Raw page)" />
                        <TextBlock
                            Grid.Row="4"
                            Style="{StaticResource CodeTextStyle}"
                            Text="Enter" />
                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="1"
                            Text="Open the selected light in the Control page (on the Lights page)" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>

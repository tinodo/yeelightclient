<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Yeelight.TestApp.Views.RawPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:controls="using:Yeelight.TestApp.Controls"
    xmlns:local="using:Yeelight.TestApp.Views"
    xmlns:models="using:Yeelight.TestApp.Models"
    xmlns:session="using:Yeelight.TestApp.Session"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Raw" />
            <TextBlock
                Style="{StaticResource SecondaryBodyStyle}"
                Text="The explorer of the protocol: send any method with any parameters and see exactly what the light answers (the id, whether it worked, the error, the values), read properties by name, and look up what each method takes. Nothing is added to the method and nothing is checked before it is sent." />
        </StackPanel>

        <controls:WrapPanel
            Grid.Row="1"
            HorizontalSpacing="12"
            VerticalSpacing="8">
            <ComboBox
                x:Name="LightBox"
                Width="300"
                AutomationProperties.Name="Light to send to"
                ItemsSource="{x:Bind Items}"
                PlaceholderText="Choose a light"
                SelectionChanged="LightBox_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="session:LightItem">
                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox
                x:Name="TargetBox"
                Width="330"
                AutomationProperties.Name="Where to send the command"
                SelectionChanged="TargetBox_SelectionChanged" />
            <ProgressRing
                x:Name="BusyRing"
                Width="20"
                Height="20"
                VerticalAlignment="Center"
                AutomationProperties.Name="A command is on its way"
                IsActive="False" />
        </controls:WrapPanel>

        <SelectorBar
            x:Name="Tabs"
            Grid.Row="2"
            AutomationProperties.Name="Sections of the Raw page"
            SelectionChanged="Tabs_SelectionChanged">
            <SelectorBarItem
                x:Name="SendTab"
                IsSelected="True"
                Tag="send"
                Text="Send a command" />
            <SelectorBarItem
                x:Name="PropertiesTab"
                Tag="properties"
                Text="Get properties" />
            <SelectorBarItem
                x:Name="ReferenceTab"
                Tag="reference"
                Text="Reference" />
        </SelectorBar>

        <Grid Grid.Row="3">

            <!-- Send a command -->
            <controls:ResponsiveSplit
                x:Name="SendView"
                Breakpoint="760"
                PrimaryShare="0.62">
                <Border Style="{StaticResource CardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="0,0,12,0" Spacing="12">
                            <ComboBox
                                x:Name="MethodBox"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Method"
                                Header="Method (choose one, or type any)"
                                IsEditable="True"
                                PlaceholderText="set_power"
                                SelectionChanged="MethodBox_SelectionChanged"
                                TextSubmitted="MethodBox_TextSubmitted" />
                            <TextBlock x:Name="MethodInfo" Style="{StaticResource SecondaryCaptionStyle}" />
                            <TextBox
                                x:Name="ParamsBox"
                                Height="96"
                                AutomationProperties.Name="Parameters as a JSON array"
                                Header="Parameters (a JSON array, empty for none)"
                                KeyDown="ParamsBox_KeyDown"
                                Style="{StaticResource CodeTextBoxStyle}" />
                            <controls:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                <Button
                                    x:Name="SendButton"
                                    AutomationProperties.Name="Send the command"
                                    Click="SendButton_Click"
                                    Style="{StaticResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="Sends the command (Ctrl+Enter)">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="&#xE724;" />
                                        <TextBlock Text="Send" />
                                    </StackPanel>
                                    <Button.KeyboardAccelerators>
                                        <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                                    </Button.KeyboardAccelerators>
                                </Button>
                                <Button
                                    x:Name="FillExampleButton"
                                    AutomationProperties.Name="Fill in an example of the parameters"
                                    Click="FillExampleButton_Click"
                                    Content="Fill in an example" />
                                <Button
                                    x:Name="NextExampleButton"
                                    AutomationProperties.Name="Fill in the next example of the method"
                                    Click="NextExampleButton_Click"
                                    Content="Next example" />
                            </controls:WrapPanel>
                            <InfoBar
                                x:Name="ResultBar"
                                IsClosable="False"
                                IsOpen="False"
                                Severity="Informational" />
                            <TextBox
                                x:Name="ResultBox"
                                Height="150"
                                AutomationProperties.Name="Answer of the light"
                                Header="Answer"
                                IsReadOnly="True"
                                PlaceholderText="The answer of the light appears here"
                                Style="{StaticResource CodeTextBoxStyle}" />
                            <Button
                                x:Name="CopyResultButton"
                                AutomationProperties.Name="Copy the answer"
                                Click="CopyResultButton_Click"
                                Content="Copy answer" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Padding="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <controls:WrapPanel
                            Margin="16,12,16,8"
                            HorizontalSpacing="8"
                            VerticalSpacing="4">
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="History" />
                            <Button
                                x:Name="ClearHistoryButton"
                                AutomationProperties.Name="Clear the history"
                                Click="ClearHistoryButton_Click"
                                Content="Clear" />
                            <TextBlock
                                x:Name="HistoryCount"
                                VerticalAlignment="Center"
                                Style="{StaticResource SecondaryCaptionStyle}" />
                        </controls:WrapPanel>
                        <ListView
                            x:Name="HistoryList"
                            Grid.Row="1"
                            AutomationProperties.Name="Commands that were sent"
                            ItemsSource="{x:Bind History}"
                            SelectionChanged="HistoryList_SelectionChanged"
                            SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:RawHistoryItem">
                                    <Grid Padding="0,4" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Top"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="{x:Bind Mark}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock
                                                FontFamily="{StaticResource CodeFontFamily}"
                                                FontSize="12"
                                                Text="{x:Bind Command}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                            <TextBlock
                                                Style="{StaticResource SecondaryCaptionStyle}"
                                                Text="{x:Bind Summary}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="NoWrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource CodeTextStyle}"
                                                Text="{x:Bind TimeText}" />
                                            <TextBlock
                                                HorizontalAlignment="Right"
                                                Style="{StaticResource SecondaryCaptionStyle}"
                                                Text="{x:Bind TargetText}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            x:Name="HistoryEmpty"
                            Grid.Row="1"
                            Margin="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Style="{StaticResource SecondaryBodyStyle}"
                            Text="The commands that you send are listed here. Select one to fill in the form with it again."
                            TextAlignment="Center" />
                    </Grid>
                </Border>
            </controls:ResponsiveSplit>

            <!-- Get properties -->
            <Border
                x:Name="PropertiesView"
                Style="{StaticResource CardStyle}"
                Visibility="Collapsed">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource SecondaryBodyStyle}" Text="get_prop reads the properties that you name, one value for each, in the same order; a name that the light does not know has an empty value. What the light says is taken over by the library as well." />
                    <TextBox
                        x:Name="NamesBox"
                        Grid.Row="1"
                        Height="84"
                        AutomationProperties.Name="Names of the properties"
                        Header="Names (separated by spaces, commas or lines)"
                        Style="{StaticResource CodeTextBoxStyle}"
                        Text="power bright ct rgb hue sat color_mode" />
                    <controls:WrapPanel
                        Grid.Row="2"
                        HorizontalSpacing="8"
                        VerticalSpacing="8">
                        <Button
                            x:Name="GetPropertiesButton"
                            AutomationProperties.Name="Get the properties"
                            Click="GetPropertiesButton_Click"
                            Content="Get properties"
                            Style="{StaticResource AccentButtonStyle}" />
                        <Button
                            x:Name="AllNamesButton"
                            AutomationProperties.Name="Fill in all the names of the protocol"
                            Click="AllNamesButton_Click"
                            Content="All names" />
                        <Button
                            x:Name="CopyPropertiesButton"
                            AutomationProperties.Name="Copy the values"
                            Click="CopyPropertiesButton_Click"
                            Content="Copy values" />
                        <TextBlock
                            x:Name="PropertiesStatus"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryCaptionStyle}" />
                    </controls:WrapPanel>
                    <Border
                        Grid.Row="3"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid>
                            <ListView
                                x:Name="PropertyList"
                                AutomationProperties.Name="Values of the properties"
                                ItemsSource="{x:Bind PropertyValues}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PropertyRow">
                                        <Grid Padding="0,2" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                FontFamily="{StaticResource CodeFontFamily}"
                                                Text="{x:Bind Name}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontFamily="{StaticResource CodeFontFamily}"
                                                IsTextSelectionEnabled="True"
                                                Text="{x:Bind Value}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                x:Name="PropertiesEmpty"
                                Margin="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Style="{StaticResource SecondaryBodyStyle}"
                                Text="The values appear here."
                                TextAlignment="Center" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Reference -->
            <Border
                x:Name="ReferenceView"
                Padding="0"
                Style="{StaticResource CardStyle}"
                Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <controls:WrapPanel
                        Margin="16,12,16,8"
                        HorizontalSpacing="12"
                        VerticalSpacing="8">
                        <AutoSuggestBox
                            x:Name="ReferenceFilter"
                            Width="280"
                            AutomationProperties.Name="Filter the methods and the properties"
                            PlaceholderText="Filter by name or text"
                            QueryIcon="Find"
                            TextChanged="ReferenceFilter_TextChanged" />
                        <TextBlock
                            MaxWidth="640"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryCaptionStyle}"
                            Text="Select a method to use it in Send. A summary in the words of this app of the Yeelight WiFi Light Inter-Operation Specification (tables 4-1 and 4-2): yeelight.com/download/Yeelight_Inter-Operation_Spec.pdf" />
                    </controls:WrapPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="16,0,28,16" Spacing="8">
                            <TextBlock
                                x:Name="MethodsTitle"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Methods" />
                            <ListView
                                x:Name="MethodList"
                                AutomationProperties.Name="Methods of the protocol"
                                IsItemClickEnabled="True"
                                ItemClick="MethodList_ItemClick"
                                ItemsSource="{x:Bind Methods}"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollMode="Disabled"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProtocolMethod">
                                        <Grid Padding="0,6" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="2*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock
                                                    FontFamily="{StaticResource CodeFontFamily}"
                                                    FontWeight="SemiBold"
                                                    Text="{x:Bind Name}" />
                                                <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind Group}" />
                                            </StackPanel>
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind Parameters}"
                                                TextWrapping="Wrap" />
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" />
                                                <TextBlock
                                                    Style="{StaticResource SecondaryCaptionStyle}"
                                                    Text="{x:Bind Notes}"
                                                    Visibility="{x:Bind local:Fmt.VisibleIfText(Notes)}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock
                                x:Name="PropertiesTitle"
                                Margin="0,12,0,0"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Properties (get_prop, and the props notification of the light)" />
                            <ItemsControl
                                x:Name="ReferenceProperties"
                                AutomationProperties.Name="Properties of the protocol"
                                ItemsSource="{x:Bind ReferenceRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProtocolProperty">
                                        <Grid Padding="12,4" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                FontFamily="{StaticResource CodeFontFamily}"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Name}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind Meaning}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
